[Unit]
Description=Assetto Corsa dedicated server (acserver-rs)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=acserver-rs
Group=acserver-rs

# StateDirectory creates/owns /var/lib/acserver-rs (0750) and keeps it writable
# under ProtectSystem=strict. The server writes results/*.json next to the
# config files, so the --cfg directory must live inside it.
StateDirectory=acserver-rs
WorkingDirectory=/var/lib/acserver-rs

# Optional overrides: ACSERVER_CFG, ACSERVER_CONTENT_FLAG, ACSERVER_DEBUG.
# Checksums default on against /var/lib/acserver-rs/content; blank ACSERVER_CONTENT_FLAG
# in /etc/sysconfig/acserver-rs to run without file verification.
Environment=ACSERVER_CFG=/var/lib/acserver-rs/cfg
Environment="ACSERVER_CONTENT_FLAG=--content /var/lib/acserver-rs/content"
Environment=ACSERVER_DEBUG=
EnvironmentFile=-/etc/sysconfig/acserver-rs
ExecStart=/usr/local/bin/acserver-rs --cfg ${ACSERVER_CFG} $ACSERVER_CONTENT_FLAG $ACSERVER_DEBUG

Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM

# Logging: the server writes slog text output to stderr.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acserver-rs

# --- Hardening ---------------------------------------------------------
# Default ports (9600 TCP/UDP, 8081 HTTP) are unprivileged; no capabilities
# are needed. If you move the HTTP API below 1024, add:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# Drop PrivateUsers if you bind-mount content from an NFS/CIFS share or hit
# permission errors on files owned by other users.
PrivateUsers=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027

# Resource limits: one process, a few goroutines, one socket per player.
LimitNOFILE=8192
TasksMax=128

[Install]
WantedBy=multi-user.target
